{
  "expo": {
    "name": "TripWise",
    "slug": "tripwise",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/tripwise-icon.png",
    "scheme": "tripwise",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "package": "com.kadirshn.tripwise",
      "adaptiveIcon": {
        "backgroundColor": "#062E2B",
        "foregroundImage": "./assets/brand/tripwise-android-foreground.png",
        "monochromeImage": "./assets/brand/tripwise-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": []
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/tripwise-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#062E2B",
          "image": "./assets/brand/tripwise-splash.png",
          "imageWidth": 184,
          "dark": {
            "backgroundColor": "#041F1D",
            "image": "./assets/brand/tripwise-splash.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-localization",
      "expo-sharing",
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ca089604-473c-4afa-82fb-573b6498d4b4"
      }
    },
    "owner": "kadirshn"
  }
}
